                          SizedBox(height: isCompactHeight ? 14 : 20),

                          // 3 Menu Choice Buttons: 横画面時は横並び、縦画面時は縦並び
                          if (isLandscape)
                            Wrap(
                              spacing: 16,
                              runSpacing: 12,
                              alignment: WrapAlignment.center,
                              children: [
                                _buildMenuButton(
                                  icon: Icons.play_arrow,
                                  label: '試合開始',
                                  color: Colors.red.shade900,
                                  width: buttonWidth,
                                  height: buttonHeight,
                                  onPressed: () {
                                    Navigator.of(context).push(
                                      MaterialPageRoute(
                                        builder: (_) => GamePage(
                                          isDebugEnabled: _debugEnabled,
                                        ),
                                      ),
                                    );
                                  },
                                ),
                                _buildMenuButton(
                                  icon: Icons.auto_stories,
                                  label: '心得',
                                  color: Colors.amber.shade900,
                                  width: buttonWidth,
                                  height: buttonHeight,
                                  onPressed: _openGuideDialog,
                                ),
                                _buildMenuButton(
                                  icon: Icons.settings,
                                  label: '設定',
                                  color: Colors.blueGrey.shade900,
                                  width: buttonWidth,
                                  height: buttonHeight,
                                  onPressed: _openSettingsDialog,
                                ),
                              ],
                            )
                          else
                            Column(
                              mainAxisSize: MainAxisSize.min,
                              children: [
                                _buildMenuButton(
                                  icon: Icons.play_arrow,
                                  label: '試合開始',
                                  color: Colors.red.shade900,
                                  width: buttonWidth,
                                  height: buttonHeight,
                                  onPressed: () {
                                    Navigator.of(context).push(
                                      MaterialPageRoute(
                                        builder: (_) => GamePage(
                                          isDebugEnabled: _debugEnabled,
                                        ),
                                      ),
                                    );
                                  },
                                ),
                                const SizedBox(height: 14),
                                _buildMenuButton(
                                  icon: Icons.auto_stories,
                                  label: '心得',
                                  color: Colors.amber.shade900,
                                  width: buttonWidth,
                                  height: buttonHeight,
                                  onPressed: _openGuideDialog,
                                ),
                                const SizedBox(height: 14),
                                _buildMenuButton(
                                  icon: Icons.settings,
                                  label: '設定',
                                  color: Colors.blueGrey.shade900,
                                  width: buttonWidth,
                                  height: buttonHeight,
                                  onPressed: _openSettingsDialog,
                                ),
                              ],
                            ),
                        ],
                      ),
                    ),
                  );
                },
              ),
            ),
          ],
        ),
