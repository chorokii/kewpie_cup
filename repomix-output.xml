                    '・青円１タップ＝防御、２タップで後ろ回避\n'
                    '・敵の攻撃は予兆があるので、見極めて防御',
                    style: TextStyle(color: Colors.white70, fontSize: 13, height: 1.4),
                  ),
                  const SizedBox(height: 10),
                  // _buildSectionHeader('【キーボード操作（PC）】'),
                  // const Text(
                  //   '・Q キー: 画面左側タップ相当\n'
